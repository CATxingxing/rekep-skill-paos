+def _parse_state_log(value: Any) -> tuple[str | None, float]:
+    if value is None:
+        return None, 25.0
+    if not isinstance(value, dict) or not isinstance(value.get("path"), str) or not value["path"].strip():
+        raise ValueError("state_log 必须是包含非空 path 的字典")
+    hz = float(value.get("hz", 25.0))
+    if not math.isfinite(hz) or hz <= 0:
+        raise ValueError("state_log.hz 必须为正数")
+    return value["path"].strip(), hz
+
