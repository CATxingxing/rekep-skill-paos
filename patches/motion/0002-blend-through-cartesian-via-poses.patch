@@ -119,3 +119,145 @@ def _quintic_position_scale(tau: float) -> float:
 
 def _quintic_velocity_scale(tau: float) -> float:
     return 30.0 * tau**2 - 60.0 * tau**3 + 30.0 * tau**4
