+def _segment_distance(point, start, end) -> float:
+    import numpy as np
+
+    direction = end - start
+    length = float(np.dot(direction, direction))
+    fraction = 0.0 if length <= 0.0 else min(1.0, max(0.0, float(np.dot(point - start, direction)) / length))
+    return float(np.linalg.norm(point - (start + fraction * direction)))
