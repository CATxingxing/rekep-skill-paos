+
+def plan_quintic_path_trajectory(
+    *,
+    joint_names: tuple[str, ...],
+    waypoints: tuple[tuple[float, ...], ...],
+    max_velocity: tuple[float, ...],
+    max_acceleration: tuple[float, ...],
+    velocity_scale: float,
+    acceleration_scale: float,
+    sample_period_ns: int,
+    max_points: int = 10_000,
+) -> PlannedTrajectory:
+    """One rest-to-rest trajectory through joint waypoints without stopping.
+
+    The joint path is a monotone C1 cubic Hermite (PCHIP) curve through the
+    waypoints, parameterised by the time each piece needs at full joint speed,
+    and traversed with a quintic time scaling. Limits are enforced from the
+    sampled path derivatives, so every joint stays within the scaled velocity
+    and acceleration limits along the whole path.
+    """
+    size = len(joint_names)
+    if size == 0 or len(max_velocity) != size or len(max_acceleration) != size:
+        raise TrajectoryGenerationError("trajectory vectors must match the non-empty joint group")
+    if not 0.0 < velocity_scale <= 1.0 or not 0.0 < acceleration_scale <= 1.0:
+        raise TrajectoryGenerationError("trajectory scales must be in the interval (0, 1]")
+    if sample_period_ns <= 0 or max_points < 2:
+        raise TrajectoryGenerationError("sample period and max_points must be positive")
+    if len(waypoints) < 2 or any(len(point) != size for point in waypoints):
+        raise TrajectoryGenerationError("a path needs at least two complete joint waypoints")
+    values = [value for point in waypoints for value in point] + list(max_velocity) + list(max_acceleration)
+    if any(not math.isfinite(value) for value in values):
+        raise TrajectoryGenerationError("trajectory inputs must be finite")
+    if any(value <= 0.0 for value in (*max_velocity, *max_acceleration)):
+        raise TrajectoryGenerationError("joint velocity and acceleration limits must be positive")
+
+    knots: list[float] = [0.0]
+    points: list[tuple[float, ...]] = [tuple(waypoints[0])]
+    for point in waypoints[1:]:
+        step = max(abs(b - a) / v for a, b, v in zip(points[-1], point, max_velocity, strict=True))
+        if step > 0.0:
+            knots.append(knots[-1] + step)
+            points.append(tuple(point))
+    if len(points) == 1:
+        return plan_quintic_trajectory(
+            joint_names=joint_names, start_positions=points[0], target_positions=points[0],
+            max_velocity=max_velocity, max_acceleration=max_acceleration,
+            velocity_scale=velocity_scale, acceleration_scale=acceleration_scale,
+            sample_period_ns=sample_period_ns, requested_duration_ns=None, max_points=max_points,
+        )
+    slopes = [_pchip_slopes(knots, [point[j] for point in points]) for j in range(size)]
+    total = knots[-1]
+
+    def evaluate(u: float) -> tuple[list[float], list[float], list[float]]:
+        k = max(0, min(len(knots) - 2, _interval(knots, u)))
+        h = knots[k + 1] - knots[k]
+        t = min(1.0, max(0.0, (u - knots[k]) / h))
+        position, first, second = [], [], []
+        for j in range(size):
+            y0, y1 = points[k][j], points[k + 1][j]
+            m0, m1 = slopes[j][k], slopes[j][k + 1]
+            position.append((2*t**3 - 3*t**2 + 1)*y0 + (t**3 - 2*t**2 + t)*h*m0 + (-2*t**3 + 3*t**2)*y1 + (t**3 - t**2)*h*m1)
+            first.append(((6*t**2 - 6*t)*y0 + (3*t**2 - 4*t + 1)*h*m0 + (-6*t**2 + 6*t)*y1 + (3*t**2 - 2*t)*h*m1) / h)
+            second.append(((12*t - 6)*y0 + (6*t - 4)*h*m0 + (-12*t + 6)*y1 + (6*t - 2)*h*m1) / (h*h))
+        return position, first, second
+
+    first_max = [0.0] * size
+    second_max = [0.0] * size
+    for k in range(len(knots) - 1):
+        for index in range(33):
+            _, first, second = evaluate(knots[k] + (knots[k + 1] - knots[k]) * index / 32)
+            for j in range(size):
+                first_max[j] = max(first_max[j], abs(first[j]))
+                second_max[j] = max(second_max[j], abs(second[j]))
+    minimum_s = 0.0
+    for j in range(size):
+        velocity = max_velocity[j] * velocity_scale
+        acceleration = max_acceleration[j] * acceleration_scale
+        minimum_s = max(
+            minimum_s,
+            _MAX_QUINTIC_VELOCITY * total * first_max[j] / velocity,
+            math.sqrt((second_max[j] * (total * _MAX_QUINTIC_VELOCITY) ** 2 + first_max[j] * total * _MAX_QUINTIC_ACCELERATION) / acceleration),
+        )
+    duration_ns = max(sample_period_ns, math.ceil(minimum_s * 1_000_000_000.0))
+    segment_count = max(1, math.ceil(duration_ns / sample_period_ns))
+    if segment_count + 1 > max_points:
+        raise TrajectoryGenerationError(f"trajectory requires {segment_count + 1} points, exceeding limit {max_points}")
+    duration_s = duration_ns / 1_000_000_000.0
+    samples: list[JointTrajectoryPoint] = []
+    for index in range(segment_count + 1):
+        time_ns = duration_ns if index == segment_count else index * duration_ns // segment_count
+        tau = index / segment_count
+        u = total * _quintic_position_scale(tau)
+        position, first, _ = evaluate(u)
+        rate = total * _quintic_velocity_scale(tau) / duration_s
+        if index == segment_count:
+            position = list(points[-1])
+        samples.append(JointTrajectoryPoint(
+            positions=position, velocities=[rate * value for value in first],
+            accelerations=[], effort=[], time_from_start_ns=time_ns,
+        ))
+    return PlannedTrajectory(
+        trajectory=JointTrajectory(joint_names=list(joint_names), points=samples),
+        duration_ns=duration_ns,
+        minimum_duration_ns=duration_ns,
+    )
+
+
+def _interval(knots: list[float], u: float) -> int:
+    low, high = 0, len(knots) - 1
+    while high - low > 1:
+        middle = (low + high) // 2
+        if knots[middle] <= u:
+            low = middle
+        else:
+            high = middle
+    return low
+
+
+def _pchip_slopes(knots: list[float], values: list[float]) -> list[float]:
+    """Fritsch-Carlson monotone slopes: no overshoot between waypoints."""
+    count = len(values)
+    widths = [knots[k + 1] - knots[k] for k in range(count - 1)]
+    secants = [(values[k + 1] - values[k]) / widths[k] for k in range(count - 1)]
+    if count == 2:
+        return [secants[0], secants[0]]
+    slopes = [0.0] * count
+    for k in range(1, count - 1):
+        if secants[k - 1] * secants[k] <= 0.0:
+            slopes[k] = 0.0
+        else:
+            w1 = 2 * widths[k] + widths[k - 1]
+            w2 = widths[k] + 2 * widths[k - 1]
+            slopes[k] = (w1 + w2) / (w1 / secants[k - 1] + w2 / secants[k])
+    for end, (h0, h1, d0, d1) in ((0, (widths[0], widths[1], secants[0], secants[1])), (count - 1, (widths[-1], widths[-2], secants[-1], secants[-2]))):
+        slope = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1)
+        if slope * d0 <= 0.0:
+            slope = 0.0
+        elif d0 * d1 <= 0.0 and abs(slope) > 3 * abs(d0):
+            slope = 3 * d0
+        slopes[end] = slope
+    return slopes
