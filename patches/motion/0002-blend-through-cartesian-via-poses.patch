@@ -0,0 +1,93 @@
+from __future__ import annotations
+
+import json
+import math
+
+import pytest
+from forge_motion_server.kinematics import InverseKinematicsOutcome
+from forge_motion_server.node import _via_poses
+from forge_motion_server.planner import KinematicPlanner, PlanningFailure
+from forge_motion_server.trajectory import TrajectoryGenerationError, plan_quintic_path_trajectory
+from forge_msgs import MovePoseGoal, Pose
+
+
+class IdentityKinematics:
+    """Joint positions are the Cartesian position; orientation is identity."""
+
+    def __init__(self, offset_index: int | None = None) -> None:
+        self.seeds: list[tuple[float, ...]] = []
+        self.offset_index = offset_index
+
+    def validate_positions(self, group_name, positions):
+        if any(abs(value) > 2.0 for value in positions):
+            raise ValueError("outside fake joint limits")
+
+    def inverse(self, group_name, target_pose, seed_positions, timeout_ns, position_tolerance_m, orientation_tolerance_rad):
+        self.seeds.append(tuple(seed_positions))
+        solution = [target_pose.x, target_pose.y, target_pose.z]
+        if self.offset_index is not None and len(self.seeds) - 1 == self.offset_index:
+            solution[1] += 0.05
+        return InverseKinematicsOutcome(status="SUCCESS", message="solved", positions=tuple(solution))
+
+    def forward(self, group_name, positions):
+        return Pose(x=positions[0], y=positions[1], z=positions[2])
+
+
+class State:
+    positions = (0.0, 0.0, 0.0)
+
+
+def _goal(x: float) -> MovePoseGoal:
+    return MovePoseGoal(group_name="arm", reference_frame="base", target_frame="tcp", target_pose=Pose(x=x, y=0.0, z=0.0),
+                        velocity_scale=0.5, acceleration_scale=0.5, position_tolerance_m=0.01, orientation_tolerance_rad=0.05)
+
+
+def test_path_trajectory_passes_waypoints_without_stopping_and_respects_limits():
+    waypoints = tuple((0.025 * index, 0.002 * math.sin(index), 0.0) for index in range(9))
+    planned = plan_quintic_path_trajectory(
+        joint_names=("j1", "j2", "j3"), waypoints=waypoints, max_velocity=(1.0, 1.0, 1.0), max_acceleration=(2.0, 2.0, 2.0),
+        velocity_scale=0.4, acceleration_scale=0.4, sample_period_ns=20_000_000,
+    )
+    points = planned.trajectory.points
+    assert points[0].positions == list(waypoints[0]) and points[-1].positions == list(waypoints[-1])
+    assert all(value == 0.0 for value in points[0].velocities) and all(abs(value) < 1e-9 for value in points[-1].velocities)
+    times = [point.time_from_start_ns / 1e9 for point in points]
+    for joint in range(3):
+        velocity = [(b.positions[joint] - a.positions[joint]) / (tb - ta) for a, b, ta, tb in zip(points, points[1:], times, times[1:])]
+        acceleration = [(b - a) / (tb - ta) for a, b, ta, tb in zip(velocity, velocity[1:], times[1:], times[2:])]
+        assert max(map(abs, velocity)) <= 0.4 * 1.0 + 1e-6
+        assert max(map(abs, acceleration)) <= 0.4 * 2.0 * 1.05
+    # One motion: speed never returns to zero between the first and last sample.
+    speeds = [math.hypot(*point.velocities) for point in points[1:-1]]
+    assert min(speeds) > 0.0
+
+
+def test_path_trajectory_rejects_incomplete_waypoints():
+    with pytest.raises(TrajectoryGenerationError):
+        plan_quintic_path_trajectory(joint_names=("j1",), waypoints=((0.0,),), max_velocity=(1.0,), max_acceleration=(1.0,),
+                                     velocity_scale=1.0, acceleration_scale=1.0, sample_period_ns=20_000_000)
+
+
+def test_via_poses_are_solved_in_order_with_the_previous_solution_as_seed(server_config, group_config):
+    kinematics = IdentityKinematics()
+    planner = KinematicPlanner(server_config, kinematics)
+    vias = (Pose(x=0.025, y=0.0, z=0.0), Pose(x=0.05, y=0.0, z=0.0))
+    planned = planner.plan_pose(group_config, State(), _goal(0.075), vias)
+    assert kinematics.seeds == [(0.0, 0.0, 0.0), (0.025, 0.0, 0.0), (0.05, 0.0, 0.0)]
+    assert planned.target_positions == (0.075, 0.0, 0.0)
+    assert planned.trajectory.trajectory.points[-1].positions == [0.075, 0.0, 0.0]
+
+
+def test_blended_path_that_leaves_the_cartesian_line_is_rejected(server_config, group_config):
+    planner = KinematicPlanner(server_config, IdentityKinematics(offset_index=0))
+    with pytest.raises(PlanningFailure) as failure:
+        planner.plan_pose(group_config, State(), _goal(0.075), (Pose(x=0.025, y=0.0, z=0.0),))
+    assert failure.value.error_code == "PATH_DEVIATION"
+
+
+def test_via_pose_metadata_is_parsed_and_validated():
+    event = {"metadata": {"goal_id": "g", "via_poses": json.dumps([[0.1, 0.2, 0.3, 1.0, 0.0, 0.0, 0.0]])}}
+    assert _via_poses(event) == (Pose(x=0.1, y=0.2, z=0.3, qx=1.0, qy=0.0, qz=0.0, qw=0.0),)
+    assert _via_poses({"metadata": {"goal_id": "g"}}) == ()
+    with pytest.raises(ValueError):
+        _via_poses({"metadata": {"goal_id": "g", "via_poses": json.dumps([[0.1, 0.2]])}})
