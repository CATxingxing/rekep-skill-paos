diff --git a/packages/motion_server/tests/test_ik_budget.py b/packages/motion_server/tests/test_ik_budget.py
new file mode 100644
index 0000000..f17d03f
--- /dev/null
+++ b/packages/motion_server/tests/test_ik_budget.py
@@ -0,0 +1,14 @@
+from forge_motion_server.planner import KinematicPlanner
+from forge_motion_server.state_cache import JointStateSnapshot
+
+
+def test_ik_reserves_final_pose_budget(server_config, group_config, fake_kinematics, pose_goal):
+    planner = KinematicPlanner(server_config, fake_kinematics)
+    # Trajectory generation is unrelated to the tolerance budget under test.
+    planner._trajectory = lambda *args: None
+    class State:
+        positions = (0., 0., 0.)
+    planner.plan_pose(group_config, State(), pose_goal)
+    assert fake_kinematics.inverse_tolerances == (0.005, 0.0125)
+    assert pose_goal.position_tolerance_m == 0.02
+    assert pose_goal.orientation_tolerance_rad == 0.05
