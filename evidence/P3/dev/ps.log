nguage-Action Models are Surprisingly Resistant to Forgetting in Continual Learning",  "Think Small, Act Big: Primitive Prompt Learning for Lifelong Robot Manipulation", ] out={} for t in titles:     res,err=search(t)     if err: print(f"!! {t}: ERR {err}"); continue     if not res: print(f"?? {t}: no result"); continue     best=res[0]     out[t]={"arxiv":best[1],"pub":best[2],"title":best[0]}     print(f"{best[1]:20} {best[2]}  {best[0][:80]}   <-- {t[:45]}")     time.sleep(1) json.dump(out,open("resolved_arxiv.json","w"),ensure_ascii=False,indent=1) EOF python3 resolve_arxiv.py 2>&1 | head -60
